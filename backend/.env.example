APP_NAME=SAARTHI
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1

# Database: PostgreSQL (or fallback sqlite:///./saarthi.db)
DATABASE_URL=postgresql+psycopg://saarthi:CHANGE_ME@localhost:5432/saarthi_db

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sarvam AI credentials
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v2

# Admin authentication bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@saarthi.local
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword123!
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
